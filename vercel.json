{
  "rewrites": [
    {
      "source": "/public/images/(.*)",
      "destination": "/images/$1"
    }
  ],
  "headers": [
    {
      "source": "/downloads/Angebot-StraverPflanzenExport-Angebot-14-15-16-2026.xlsx",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Angebot-StraverPflanzenExport-Angebot-14-15-16-2026.xlsx\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/images/(.*)",
